@model API.Services.Email.Models.ReceiptEmailModel
@{
    Layout = "~/Views/Emails/_Layout.cshtml";
    var font = "-apple-system,'Segoe UI',system-ui,Roboto,Arial,sans-serif";
}

<!-- Paid badge, green accent, mirroring the order page's status badge -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 20px;">
    <tr>
        <td style="background-color:#14251b;border:1px solid #22c55e;border-radius:6px;padding:4px 11px;">
            <span style="font-family:@font;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#22c55e;">Paid</span>
        </td>
    </tr>
</table>

<h1 style="margin:0 0 8px;font-family:@font;font-size:24px;font-weight:700;line-height:1.25;color:#ffffff;">Thanks for your payment</h1>
<p style="margin:0 0 24px;font-family:@font;font-size:15px;line-height:1.6;color:#9ca3af;">
    Your payment for <strong style="color:#ffffff;font-weight:600;">@Model.ItemName</strong> went through on
    @Model.PaidAt.ToLocalTime().ToString("d MMM yyyy, h:mm tt").
</p>

<!-- Order panel, deepest surface with a hairline border, like the winner email's bid block -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#1a1a1a;border:1px solid #1f2937;border-radius:10px;margin:0 0 28px;">
    <tr>
        <td style="padding:20px 24px;">
            <div style="font-family:@font;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#6b7280;">Order #@Model.OrderId</div>
            <div style="font-family:@font;font-size:28px;font-weight:700;color:#ffffff;padding-top:6px;">@Model.Amount.ToString("C")</div>
            <div style="font-family:@font;font-size:13px;color:#9ca3af;padding-top:8px;">Sold by @Model.SellerName</div>
        </td>
    </tr>
</table>

<!-- Points at our own order page, which a Stripe-sent receipt could never do -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
    <tr>
        <td align="center" bgcolor="#ff4742" style="border-radius:8px;">
            <a href="@Model.OrderUrl" target="_blank" style="display:inline-block;padding:13px 32px;font-family:@font;font-size:14px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:8px;">View your order &rarr;</a>
        </td>
    </tr>
</table>

<p style="margin:0;font-family:@font;font-size:13px;line-height:1.6;color:#6b7280;">
    If the button doesn't work, paste this link into your browser:<br>
    <a href="@Model.OrderUrl" style="color:#ff4742;text-decoration:none;word-break:break-all;">@Model.OrderUrl</a>
</p>
